# Root-level reference env file.
# Copy values into backend/.env and frontend/.env files.

# Backend
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///C:/Users/user/Desktop/ZUGDELAY/railpulse-germany/backend/db.sqlite3
DJANGO_TIME_ZONE=Europe/Berlin
DB_API_KEY=your-db-api-key
DB_TIMETABLES_BASE_URL=https://apis.deutschebahn.com/db-api-marketplace/apis/timetables/v1
DB_STADA_BASE_URL=https://apis.deutschebahn.com/db-api-marketplace/apis/station-data/v2
HTTP_TIMEOUT_SECONDS=10
DEMO_USE_SAMPLE_DATA=true
ALLOW_SAMPLE_FALLBACK=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_SAMPLE_DATA=true
